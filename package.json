{
  "name": "ae-playwright-bdd-suite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bdd": "npx bddgen",
    "tests": "npx bddgen && npx playwright test",
    "test:specific": "npx bddgen && npx playwright test login.feature",
    "test:ui-all": "npx bddgen && npx playwright test features-gen/",
    "test:ui-tag": "npx bddgen test --tags '@ui01-6' && npx playwright test features-gen/",
    "test:api-all": "npx playwright test api",
    "test:api-tag": "npx playwright test --grep @api-test",
    "test:api-specific": "npx playwright test -g 'Signup API'",
    "test:json": "npx playwright test features-gen/ --reporter=json > reports/playwright-results.json",
    "report": "npx playwright show-report reports/playwright-html",
    "allure:generate": "allure generate reports/allure-results --output reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "npx allure serve reports/allure-results",
    "test:ui-tag:ai-report": "npm run test:ui-tag && npm run test:json && npm run report:ai",
    "report:ai": "npx ts-node src/reporter/ai.reporter.ts",
    "report:ai:open": "open reports/ai-report/index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.0",
    "@types/node": "^25.5.0",
    "allure": "^3.8.2",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0",
    "playwright-bdd": "^8.5.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
